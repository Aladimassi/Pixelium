# MySQL (XAMPP) — products & users
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pixelium_consent

# JWT for login sessions
JWT_SECRET=pixelium-dev-jwt-secret-change-in-production

# Groq API — get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Service ports (optional)
BROKER_PORT=4000
ECOMMERCE_PORT=4001
PAYMENT_PORT=4002
DASHBOARD_PORT=3000

# Password reset email (optional in dev — reset link is logged to broker console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pixelium Store <noreply@pixelium.com>
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
