# ── Public URLs (browser must reach the broker) ─────────────────────────────
# Local Docker:
PUBLIC_URL=https://pixelium.duckdns.org
BROKER_URL=/broker
PUBLIC_HTTP_PORT=80

# VPS / domain example:
# PUBLIC_URL=https://shop.example.com
# BROKER_URL=https://shop.example.com/broker

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=pixelium
MYSQL_PASSWORD=change-me-app-password
MYSQL_DATABASE=pixelium_consent

# ── Auth (use a long random string in production) ────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret

# ── Groq AI (required for AI shopping + voice) ───────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Password reset email (Brevo) ─────────────────────────────────────────────
# 1. https://app.brevo.com → Settings → SMTP & API → SMTP tab
# 2. Copy "Login" (often xxx@smtp-brevo.com) → SMTP_USER
# 3. Generate SMTP key → SMTP_PASS (NOT your API key or Brevo password)
# 4. Settings → Senders → verify the address used in SMTP_FROM
PUBLIC_APP_URL=https://pixelium.duckdns.org
CORS_ORIGINS=https://pixelium.duckdns.org
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=Pixelium Store <your-verified-email@example.com>
