# ── Public URLs (browser must reach the broker) ─────────────────────────────
# Local Docker:
PUBLIC_URL=https://pixelium.duckdns.org
BROKER_URL=/broker
PUBLIC_HTTP_PORT=80

# VPS / domain example:
# PUBLIC_URL=https://shop.example.com
# BROKER_URL=https://shop.example.com/broker

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=pixelium
MYSQL_PASSWORD=change-me-app-password
MYSQL_DATABASE=pixelium_consent

# ── Auth (use a long random string in production) ────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret

# ── Groq AI (required for AI shopping + voice) ───────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
